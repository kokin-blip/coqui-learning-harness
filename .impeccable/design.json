      "description": "Compact single choice with native radio state and selected fill.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" name=\"ds-answer\" checked/> Follow the negative gradient</label>",
      "css": ".ds-answer{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:flex;align-items:center;gap:10px;min-height:36px;padding:8px 10px;border-radius:9px;font-size:13px;font-weight:400;color:var(--ink, #253c35);background:var(--soft, #e0e9e2);border:1px solid transparent;cursor:pointer}.ds-answer:has(input:checked){background:var(--selected, rgba(207, 227, 211, 0.78));color:var(--accent, #316a49);border-color:var(--edge-strong,rgba(255,255,255,.88));box-shadow:inset 0 1px 1px rgba(255,255,255,.1)}.ds-answer input{width:16px;height:16px;margin:0;accent-color:var(--accent, #316a49);flex:none}.ds-answer:hover{border-color:var(--edge-strong,rgba(255,255,255,.88))}.ds-answer input:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    }
