  "narrative": {
    "northStar": "Moonforest / Dew",
    "overview": "CoquiLearn is a quiet learning instrument with the material polish of a Mac app. Moonforest and Dew share forest-tinted neutrals, a leaf-green action color, the original vector coquí mark, rounded outline graphics, and the macOS system face. The lesson, current question, and learner’s reasoning carry attention; translucent chrome supports them.\n\nThe current composition follows the user’s compact desktop reference: a full-width title bar, slim destination rail, adjacent session sidebar, centered reading column with a bottom-anchored composer, and one right inspector. It replaces the earlier floating shell’s spacing while retaining the approved visual world. Glass is interpreted through CSS blur, highlights, and native window vibrancy; this record makes no claim of matching Figma’s refractive renderer.",
    "keyCharacteristics": [
      "Compact persistent navigation; open reading space.",
      "Stable text with localized glass on chrome and contextual surfaces.",
      "One active input and one context inspector.",
      "Interruptible selection continuity with reduced-motion and opaque-material alternatives."
    ],
    "rules": [
      {
        "name": "The Stable Reading Rule",
        "body": "Keep long explanations and the active question stable; glass belongs to their supporting surfaces.",
        "section": "elevation"
      },
      {
        "name": "The Context Attachment Rule",
        "body": "Keep the model picker attached to its trigger with a measured 8px gap when space permits, and clamp the surface to the viewport.",
        "section": "components"
      },
      {
        "name": "The Evidence Rule",
        "body": "Label illustrative sessions and offline fixtures honestly; a screenshot is visual evidence, not proof of live inference or feature parity.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the Moonforest/Dew semantic color roles and original coquí vector assets.",
      "Do use the macOS system font stack and retain separate reading and compact-control hierarchies.",
      "Do keep the transcript and anchored composer aligned within the same reading column.",
      "Do consolidate lesson context in one inspector and yield it before reducing reading space.",
      "Do preserve visible focus, text/icon state cues, reduced motion, and opaque glass fallbacks.",
      "Do identify demonstration content as fixtures and record provider verification separately."
    ],
    "donts": [
      "Don’t restore the earlier floating shell’s outer gutters or multiple competing lesson panels.",
      "Don’t tint every paragraph as a card or put moving refraction behind active reading text.",
      "Don’t reduce the composer model trigger below its corrected 12px size.",
      "Don’t position contextual popovers using an assumed fixed height.",
      "Don’t replace authored vector graphics with emoji or mix unrelated icon grammars.",
      "Don’t copy private reference-screenshot content into the app or include that screenshot in distribution.",
      "Don’t treat planned Figma screens, synthetic color ramps, or fixture checks as shipped runtime capability."
    ]
  }
}
