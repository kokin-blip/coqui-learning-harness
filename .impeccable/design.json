      "css": ".ds-pill{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:inline-flex;align-items:center;padding:5px 16px;line-height:18px;border-radius:999px;background:var(--soft, #e0e9e2);color:var(--muted, #526d63);font-size:12px;white-space:nowrap}"
    },
    {
      "name": "Context inspector",
      "kind": "card",
      "refersTo": "inspector",
      "description": "One context surface with restrained section dividers.",
      "html": "<aside class=\"ds-inspector\"><header class=\"ds-inspector-header\">Session context</header><details class=\"ds-inspector-section\"><summary>Learning path</summary><p>Current step and supporting context.</p></details><div class=\"ds-inspector-section\">No background work running.</div></aside>",
      "css": ".ds-inspector{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;width:300px;max-width:100%;color:var(--ink, #253c35);background:color-mix(in srgb,var(--soft, #e0e9e2) 74%,var(--mist, rgba(250, 252, 247, 0.72)));border:1px solid color-mix(in srgb,var(--edge, rgba(255, 255, 255, 0.65)) 65%,transparent);border-radius:16px;overflow:auto;backdrop-filter:blur(18px) saturate(1.1);font-size:13px;line-height:21px}.ds-inspector-header{padding:17px 18px 14px;font-size:12px;font-weight:500;color:var(--muted, #526d63)}.ds-inspector-section{padding:13px 18px;border-top:1px solid color-mix(in srgb,var(--line,#b9cec0) 18%,transparent)}.ds-inspector-section summary{min-height:32px;cursor:pointer}.ds-inspector-section summary:hover{color:var(--accent, #316a49)}.ds-inspector-section summary:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}.ds-inspector-section p{margin:14px 0 0}"
    },
    {
      "name": "Anchored composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Chat dock material; runtime anchors this inside the reading column.",
      "html": "<section class=\"ds-composer\"><textarea class=\"ds-composer-input\" aria-label=\"Continue learning\" placeholder=\"What would you like to explore next?\"></textarea><footer class=\"ds-composer-footer\"><span>Adaptive learning</span><button class=\"ds-composer-model\">Use default model <svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg></button></footer></section>",
      "css": ".ds-composer{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;padding:14px 16px 12px;border-radius:16px;color:var(--ink, #253c35);background:color-mix(in srgb,var(--soft, #e0e9e2) 74%,var(--mist, rgba(250, 252, 247, 0.72)));border:1px solid color-mix(in srgb,var(--edge-strong,rgba(255,255,255,.88)) 70%,transparent);box-shadow:0 5px 18px color-mix(in srgb,var(--shadow, rgba(6, 14, 17, 0.17)) 55%,transparent),inset 0 1px 0 var(--edge, rgba(255, 255, 255, 0.65));backdrop-filter:blur(20px) saturate(1.12)}.ds-composer-input{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:block;width:100%;min-height:44px;padding:0 0 8px;background:transparent;color:var(--ink, #253c35);border:0;resize:vertical;font-size:14px;line-height:23px}.ds-composer-input::placeholder{color:var(--muted, #526d63);opacity:1}.ds-composer-footer{display:flex;align-items:center;gap:10px;min-height:32px;color:var(--muted, #526d63);font-size:10px}.ds-composer-model{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;margin-left:auto;display:inline-flex;align-items:center;gap:5px;background:transparent;border:0;border-radius:4px;color:var(--muted, #526d63);font-size:12px;line-height:18px;min-height:22px;padding:0;cursor:pointer}.ds-composer-model:hover{color:var(--accent, #316a49)}.ds-composer-model:active{transition-duration:.1s}.ds-composer-model:focus-visible,.ds-composer-input:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    },
    {
      "name": "Model picker empty state",
      "kind": "custom",
      "refersTo": "model-picker",
      "description": "Fixture-friendly empty catalog; placement and keyboard selection are runtime behavior.",
      "html": "<section class=\"ds-picker\"><input class=\"ds-picker-search\" aria-label=\"Search models\" placeholder=\"Search by model or provider…\"/><button class=\"ds-picker-default\">Use default model</button><p class=\"ds-picker-empty\">No available models match. Check your connections or try another term.</p></section>",
      "css": ".ds-picker{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:flex;flex-direction:column;gap:12px;max-width:400px;max-height:min(360px,calc(100vh - 32px));padding:16px;color:var(--ink, #253c35);background:var(--mist, rgba(250, 252, 247, 0.72));border:1px solid var(--edge, rgba(255, 255, 255, 0.65));border-radius:20px;box-shadow:0 8px 24px var(--shadow, rgba(6, 14, 17, 0.17)),inset 0 1px 1px rgba(255,255,255,.1);backdrop-filter:blur(24px) saturate(1.15)}.ds-picker-search{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;min-width:0;background:var(--soft, #e0e9e2);color:var(--ink, #253c35);border:1px solid transparent;border-radius:10px;padding:10px 12px;font-size:14px}.ds-picker-search::placeholder{color:var(--muted, #526d63);opacity:1}.ds-picker-default{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;background:transparent;border:0;color:var(--muted, #526d63);text-align:left;padding:3px 0;min-height:28px;font-size:12px;cursor:pointer}.ds-picker-default:hover{color:var(--accent, #316a49)}.ds-picker-default:active{transition-duration:.1s}.ds-picker-default:focus-visible,.ds-picker-search:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}.ds-picker-empty{margin:0;color:var(--muted, #526d63);font-size:12px;line-height:17px}"
    },
