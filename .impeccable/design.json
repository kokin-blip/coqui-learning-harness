  "components": [
    {
      "name": "Compact primary action",
      "kind": "button",
      "refersTo": "button-primary-compact",
      "description": "The compact lesson action; the reusable base elsewhere is taller.",
      "html": "<button class=\"ds-primary\">Continue <svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;background:var(--accent, #316a49);color:var(--on-accent,#f5faf1);border:0;border-radius:999px;padding:7px 17px;min-height:34px;font-size:12px;line-height:20px;font-weight:600;box-shadow:inset 0 1px 1px rgba(255,255,255,.16);cursor:pointer;transition:background .18s ease-out,color .18s ease-out,box-shadow .24s ease-out}.ds-primary:hover{background:color-mix(in srgb,var(--accent, #316a49) 92%,white)}.ds-primary:active{transition-duration:.1s}.ds-primary:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}.ds-primary:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quiet alternative to a primary pill.",
      "html": "<button class=\"ds-secondary\">Cancel</button>",
      "css": ".ds-secondary{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;background:var(--soft, #e0e9e2);color:var(--ink, #253c35);border:0;border-radius:999px;padding:10px 16px;min-height:40px;font-size:13.5px;line-height:20px;cursor:pointer;transition:background .18s ease-out}.ds-secondary:hover{background:color-mix(in srgb,var(--soft, #e0e9e2) 65%,var(--accent-soft,#cfe3d3))}.ds-secondary:active{transition-duration:.1s}.ds-secondary:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "A low-emphasis contextual link-style button.",
      "html": "<button class=\"ds-text\">Open related knowledge</button>",
      "css": ".ds-text{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;background:transparent;color:var(--muted, #526d63);border:0;border-radius:12px;padding:3px 0;min-height:28px;font-size:13.5px;line-height:20px;cursor:pointer;transition:color .18s ease-out}.ds-text:hover{color:var(--accent, #316a49)}.ds-text:active{transition-duration:.1s}.ds-text:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Soft fill with a clear native editing affordance.",
      "html": "<label class=\"ds-label\">Session name<input class=\"ds-input\" placeholder=\"Name this session\" /></label>",
      "css": ".ds-label{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;display:flex;flex-direction:column;gap:10px;color:var(--ink, #253c35);font-size:13.5px;font-weight:500}.ds-input{font-family:-apple-system,BlinkMacSystemFont,\"Inter\",sans-serif;color:var(--ink, #253c35);background:var(--soft, #e0e9e2);border:1px solid transparent;border-radius:10px;padding:10px 12px;font-size:13.5px;caret-color:var(--accent, #316a49);min-width:0}.ds-input::placeholder{color:var(--muted, #526d63);opacity:1}.ds-input:hover{border-color:transparent}.ds-input:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    },
    {
      "name": "Rail destination",
      "kind": "nav",
      "refersTo": "destination-selected",
      "description": "Selected destination lens; shared-position spring is supplied by the application.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Destinations\"><button class=\"ds-destination\" aria-current=\"page\" aria-label=\"Learn\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14m0-14C8 4 4 4 2 5v14c3-1 7 0 10 2m0-14c4-3 8-3 10-2v14c-3-1-7 0-10 2\"/></svg></button></nav>",
      "css": ".ds-rail{display:flex;align-items:center;justify-content:center;width:52px;padding:12px 0;background:color-mix(in srgb,var(--chrome,rgba(212,224,218,.52)) 75%,transparent)}.ds-destination{display:flex;align-items:center;justify-content:center;width:36px;height:36px;padding:8px;color:var(--accent, #316a49);background:var(--selected, rgba(207, 227, 211, 0.78));border:1px solid var(--edge, rgba(255, 255, 255, 0.65));border-radius:10px;box-shadow:inset 0 1px 0 var(--edge-strong,rgba(255,255,255,.88));cursor:pointer}.ds-destination:hover{background:var(--selected, rgba(207, 227, 211, 0.78))}.ds-destination:active{transition-duration:.1s}.ds-destination:focus-visible{outline:2px solid var(--accent, #316a49);outline-offset:4px;}"
    },
