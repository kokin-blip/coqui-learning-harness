{
  "name": "coquilearn",
  "productName": "CoquiLearn",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "An adaptive learning studio for macOS",
  "author": "CoquiLearn contributors",
  "main": "dist/desktop/bootstrap.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/engine",
    "packages/storage",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=tap tests/*.test.ts",
    "test:engine": "node scripts/test-engine.mjs",
    "desktop:dist": "npm run build && electron-builder --mac zip dmg --arm64 --publish never && node scripts/verify-distribution.mjs",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "history": "node --import tsx scripts/history.ts",
    "format": "prettier --write apps/desktop packages/contracts packages/storage scripts tests"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "1.0.13",
    "@resvg/resvg-js": "^2.6.2",
    "@silvia-odwyer/photon-node": "0.3.4",
    "d3-force": "^3.0.0",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "dagre-d3-es": "7.0.14",
    "fflate": "^0.8.2",
    "jose": "6.2.14",
    "katex": "0.18.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.33.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-math": "3.0.0",
    "mermaid": "^11.17.0",
    "micromark-extension-math": "3.1.0",
    "motion": "^13.1.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "^6.0.0",
    "turndown": "^7.2.4",
    "typebox": "^1.3.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.1.7",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.9.3",
    "electron-builder": "26.16.1",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
